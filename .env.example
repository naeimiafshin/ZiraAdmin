# آدرس بک‌اند جنگو برای proxy سرور توسعه‌ی Vite (فقط در npm run dev)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# پیشوند API؛ در توسعه از proxy استفاده می‌شود، پس معمولاً همین مقدار درست است
VITE_API_BASE_URL=/api/v1
# نقشه‌ی انتخاب موقعیت شعبه (Leaflet). خالی ⇐ کاشی OpenStreetMap؛ برای سرور نقشه‌ی دیگر (مثلاً داخلی) آدرس کاشی و متن حق نشر را بدهید
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
