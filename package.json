{
  "name": "ziramarket-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "api:types": "openapi-typescript api-schema/admin.openapi.json -o src/shared/api/schema/admin.d.ts && openapi-typescript api-schema/public.openapi.json -o src/shared/api/schema/public.d.ts",
    "api:sync": "npm run api:fetch && npm run api:types"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.90.0",
    "jalaali-js": "^1.2.8",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-router": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/jalaali-js": "^1.2.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "openapi-typescript": "^7.9.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
